# All optional. In Portainer, set these as stack environment variables instead.

# Host port the app is published on
# HOST_PORT=8413

# Absolute host folder for reader.db (default: a named Docker volume)
# DATA_PATH=/srv/language-reader

# Require a shared token on every API request
# AUTH_TOKEN=change-me

# Fallback keys used when none is saved on the Settings page
# ANTHROPIC_API_KEY=
# DEEPL_API_KEY=

# Set to 0 to build without Voikko (Finnish morphology hints)
# WITH_VOIKKO=1
